# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-dev-only-change-me
# SQLite for local work. In production use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://vck:PASSWORD@localhost:5432/vck
DATABASE_URL=sqlite:///./vck.db
# Origins allowed to call the API from a browser (JSON list)
CORS_ORIGINS=["http://localhost:4200","http://localhost:4300"]
# Object storage. Locally a folder (default: <repo>/Object_Storage_Data, git-ignored) that the API also serves at /media.
# STORAGE_DIR=C:/path/to/Object_Storage_Data
# Public address of stored files (photos, content.json). Production: the R2 media bucket's address.
MEDIA_BASE_URL=http://localhost:8000/media
